        </mxCell>

        <!-- FOOTER NOTE -->
        <mxCell id="footer" value="&lt;b&gt;Alineación Estricta con el Código Fuente de NQS-Statistics-Service (Puerto 8420 · /api/v1):&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Endpoints vigentes:&lt;/b&gt; &lt;code&gt;GET /statistics/summary/totals/{metricCode}&lt;/code&gt;, &lt;code&gt;GET /statistics/time-series/{metricCode}&lt;/code&gt;, &lt;code&gt;GET /statistics/distributions/{metricCode}&lt;/code&gt;, &lt;code&gt;GET /health&lt;/code&gt; y &lt;code&gt;GET /actuator/health&lt;/code&gt;.&lt;br&gt;• &lt;b&gt;Excepciones RFC 7807:&lt;/b&gt; &lt;code&gt;UnauthorizedScopeException (403 ACCESS_DENIED)&lt;/code&gt;, &lt;code&gt;UnsupportedMetricScopeException (400 UNSUPPORTED_METRIC_SCOPE)&lt;/code&gt;, &lt;code&gt;InvalidTimeSeriesRequestException (400 INVALID_PERIOD)&lt;/code&gt; y &lt;code&gt;NoResourceFoundException (404 ROUTE_NOT_FOUND)&lt;/code&gt;.&lt;br&gt;• &lt;b&gt;Consumo AMQP e idempotencia:&lt;/b&gt; 100% transaccional en PostgreSQL 16 (sin Redis), con 7 routing keys exactas en &lt;code&gt;styleradar.exchange&lt;/code&gt; y DLQ &lt;code&gt;styleradar.estadisticas.dlq&lt;/code&gt;." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=12;fontFamily=Poppins;fontSize=10;fontColor=#12063A;fillColor=#F5F0E1;strokeColor=#B8A88A;" vertex="1" parent="1">
          <mxGeometry x="25" y="1120" width="1870" height="96" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
