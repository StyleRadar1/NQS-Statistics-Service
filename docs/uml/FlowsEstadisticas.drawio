        </mxCell>

        <!-- Scenario 1 messages -->
        <mxCell id="m1" value="&lt;b&gt;1.&lt;/b&gt; Publica evento JSON (7 routing keys exactas)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#5600EF;fontFamily=Poppins;fontSize=9;fontColor=#12063A;" edge="1" parent="1">
